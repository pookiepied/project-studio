# Optional. Defaults to ./data/flue.db.
PROJECT_STUDIO_DB_PATH=./data/flue.db

# Used by the generated Node server.
PORT=3000

# Observability resource attributes.
PROJECT_STUDIO_SERVICE_NAME=project-studio-v2
PROJECT_STUDIO_SERVICE_VERSION=0.1.0
PROJECT_STUDIO_DEPLOYMENT_ENVIRONMENT=development

# Exporter: none (default) | memory | otlp
# OTLP is selected automatically when an endpoint is set.
# PROJECT_STUDIO_OTEL_EXPORTER=none
# PROJECT_STUDIO_OTEL_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# GenAI content capture is off by default. Opt in only for trusted debugging.
PROJECT_STUDIO_OTEL_CAPTURE_CONTENT=false
# OTEL_GENAI_CAPTURE_CONTENT=false

# Tests only: dump in-memory telemetry on process exit.
# PROJECT_STUDIO_OTEL_MEMORY_DUMP_PATH=./tmp/telemetry.json

# Model source: test (default) | local | studio-cloud
# local and studio-cloud are recognized but not operational until Phase 7/8;
# selecting them fails bootstrap immediately with ProviderConfigurationError.
PROJECT_STUDIO_MODEL_SOURCE=test
