# Optional. Defaults to ./data/flue.db.
PROJECT_STUDIO_DB_PATH=./data/flue.db

# Used by the generated Node server.
PORT=3000

# Observability resource attributes.
PROJECT_STUDIO_SERVICE_NAME=project-studio-v2
PROJECT_STUDIO_SERVICE_VERSION=0.1.0
PROJECT_STUDIO_DEPLOYMENT_ENVIRONMENT=development

# Exporter: none (default) | memory | otlp
# OTLP is selected automatically when an endpoint is set.
# PROJECT_STUDIO_OTEL_EXPORTER=none
# PROJECT_STUDIO_OTEL_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# GenAI content capture is off by default. Opt in only for trusted debugging.
PROJECT_STUDIO_OTEL_CAPTURE_CONTENT=false
# OTEL_GENAI_CAPTURE_CONTENT=false

# Tests only: dump in-memory telemetry on process exit.
# PROJECT_STUDIO_OTEL_MEMORY_DUMP_PATH=./tmp/telemetry.json

# Model source: test (default) | local | studio-cloud
# No source is ever silently substituted for another.
PROJECT_STUDIO_MODEL_SOURCE=test

# --- Local BYOK (only when PROJECT_STUDIO_MODEL_SOURCE=local) ---
# Which model the stable project-studio/default alias routes to, as
# "<provider>/<model>". Run `pnpm providers list` to see available providers.
# PROJECT_STUDIO_LOCAL_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
#
# Providers Pi does not ship, as a JSON array. Anything speaking the OpenAI wire
# format works here, which covers Ollama, LM Studio, vLLM, LiteLLM, and most
# proxy services. Plain http is allowed only for loopback hosts.
# PROJECT_STUDIO_LOCAL_PROVIDERS=[{"id":"ollama","name":"Ollama","baseUrl":"http://127.0.0.1:11434/v1","models":["llama3.1:8b"]}]
#
# A custom provider's key may also come from <ID>_API_KEY, e.g. OLLAMA_API_KEY.
# Keys entered through `pnpm providers connect` go to the OS keychain instead.

# --- Studio gateway (only when PROJECT_STUDIO_MODEL_SOURCE=studio-cloud) ---
# PROJECT_STUDIO_GATEWAY_URL=https://api.example.com/studio/gateway
# The stable project-studio/default alias routes to this gateway model id.
# PROJECT_STUDIO_GATEWAY_DEFAULT_MODEL=anthropic:claude-sonnet-5
# PROJECT_STUDIO_GATEWAY_TIMEOUT_MS=120000

# --- Sign-in ---
# Project Studio auth service root.
# PROJECT_STUDIO_AUTH_URL=https://auth.example.com
# Google OAuth client id for the desktop harness. This must be a *public*
# client (Google "Desktop app" type): it runs on the user's machine, so it has
# no client secret and uses PKCE. The auth worker must list the same id in
# GOOGLE_DESKTOP_CLIENT_ID.
# PROJECT_STUDIO_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# PROJECT_STUDIO_AUTH_TIMEOUT_MS=30000

# Development bootstrap token. Setting it overrides the signed-in session for
# gateway calls, which the harness reports at startup. Leave it unset to use a
# real session from `pnpm auth sign-in`. This is not credential storage.
# PROJECT_STUDIO_GATEWAY_TOKEN=
