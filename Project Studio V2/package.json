{
  "name": "project-studio-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Project Studio agent harness",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "flue build --target node",
    "typecheck": "tsc --noEmit",
