    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@flue/cli": "1.0.0-beta.9",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.8"
  },
  "packageManager": "pnpm@10.23.0"
}
