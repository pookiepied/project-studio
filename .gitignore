# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ── Build output ─────────────────────────────────────────────
dist/
dist-web/
build/
out/
.vite/
*.tsbuildinfo

# ── Rust / Tauri ─────────────────────────────────────────────
src-tauri/target/
target/

# ── Environment & secrets ────────────────────────────────────
.env
.env.*
!.env.example
# Cloudflare Workers local secrets (wrangler dev) — never commit
.dev.vars
.dev.vars.*
*.pem
*.key

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.studio/

# ── Caches & coverage ────────────────────────────────────────
.cache/
coverage/
.wrangler/

# ── Generated graph output ───────────────────────────────────
graphify-out/

# ── OS / editor cruft ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
# Visual Studio per-user solution state (not project artifacts). Note: the
# intentionally-vendored ripgrep under STUDIO/vendor/ is deliberately committed.
.vs/

# ── Editor launch/debug configs ──────────────────────────────
# Keep shared launch configs tracked (mirrors the .vscode convention below);
# ignore the rest of the tool's per-user session cruft.
.claude/*
!.claude/launch.json

# ── External reference checkouts ─────────────────────────────
# Vendored copies of upstream/3rd-party projects kept locally for reference
# only — never part of this repo.
Research/
temp/
temp-v2/
# The opencode project (third-party AI development tool), checked out at the
# repo root for reference. Not ours: not written by this project, not built
# by it, and not to be committed, modified or deleted here.
opencode/

# ── Python bytecode cache ────────────────────────────────────
__pycache__/
*.pyc
