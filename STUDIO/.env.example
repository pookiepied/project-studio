# STUDIO environment. Copy to `.env` to use; `.env` is gitignored and must
# stay that way. Every name here is read in exactly one place:
# `src/platform/harness/connection.ts`.
#
# Both must be set for STUDIO to talk to the harness. With either missing,
# `resolveHarnessAddress()` returns null and the app runs with no harness at
# all -- which is the shipped behaviour today.

# Where the harness is listening. The harness binds 127.0.0.1 on a port chosen
# at launch and prints it; there is no default, so read it from the launch
# output rather than guessing.
VITE_HARNESS_BASE_URL=http://127.0.0.1:4319

# The bearer credential minted by whoever launched the harness, sent as
# `Authorization: Bearer <value>`. It is valid for that one launch and no
# longer, so it changes every restart.
#
# Do not commit a real value. `import.meta.env` is inlined into the bundle at
# build time, so a token present during a production build is baked into the
# shipped artifact. This variable is a development affordance and will be
# replaced entirely when the Tauri sidecar hands the credential over directly.
VITE_HARNESS_TOKEN=
