{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Studio",
  "version": "0.1.0",
  "identifier": "com.pookiepied.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Studio",
        "dragDropEnabled": false,
        "width": 1040,
        "height": 720,
        "minWidth": 600,
        "minHeight": 440,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:*; img-src 'self' data:; media-src 'self' blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../STUDIO HARNESS/package.json": "harness/package.json",
      "../../STUDIO HARNESS/dist/*": "harness/",
      "../../STUDIO HARNESS/vendor/": "harness/vendor/",
      "../../STUDIO HARNESS/skills/": "harness/skills/",
      "../../STUDIO HARNESS/commands/": "harness/commands/",
      "../../STUDIO HARNESS/catalog/": "harness/catalog/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
