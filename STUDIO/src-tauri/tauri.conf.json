{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Studio",
  "version": "0.1.0",
  "identifier": "com.pookiepied.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Studio",
        "width": 1040,
        "height": 720,
        "minWidth": 620,
        "minHeight": 480,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
