{
  "name": "studio",
  "private": true,
  "version": "0.1.4",
  "description": "STUDIO - AI-powered tool",
  "author": "pookiepied",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip",
    "ratchet:lint": "node scripts/ratchet.mjs lint",
    "ratchet:cycles": "node scripts/ratchet.mjs cycles",
    "gate": "npm run typecheck && npm run ratchet:lint && npm run ratchet:cycles",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-wrapper.mjs",
    "vendor:sync": "node scripts/vendor-sync.mjs",
    "web:dev": "vite --config vite.config.web.ts",
    "web:build": "vite build --config vite.config.web.ts",
    "web:preview": "vite preview --config vite.config.web.ts --outDir dist-web",
    "installer:assets": "powershell -ExecutionPolicy Bypass -File scripts/generate-installer-assets.ps1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/cascadia-code": "^5.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-select": "^2.2.6",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.35.1",
    "js-tiktoken": "^1.0.21",
    "katex": "^0.16.45",
    "mermaid": "^10.9.5",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-force-graph-3d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@vscode/ripgrep": "^1.18.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "knip": "^6.25.0",
    "madge": "^8.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.0.0"
  }
}
