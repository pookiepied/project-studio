{
  "name": "studio-gateway",
  "description": "Studio Gateway - Cloudflare Workers AI Gateway, OpenAI-compatible",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "cf:typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply studio-gateway",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/models": "^0.0.42",
    "ai": "^7.0.64",
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/google": "^4.0.43",
    "@ai-sdk/openai": "^4.0.41",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@ai-sdk/fal": "^2.0.52",
    "@ai-sdk/elevenlabs": "^2.0.51",
    "hono": "^4.7.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250810.0",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.44.2",
    "oxlint": "^1.13.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.19.0"
  }
}
