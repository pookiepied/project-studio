{
  "name": "studio-gateway",
  "description": "Studio Gateway - Cloudflare Workers AI Gateway, OpenAI-compatible",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf:typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply studio_gateway --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250810.0",
    "drizzle-orm": "^0.44.2",
    "drizzle-kit": "^0.31.1",
    "oxlint": "^1.13.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.19.0"
  }
}
