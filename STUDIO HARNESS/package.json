{
  "name": "project-studio-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Project Studio agent harness",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "auth": "tsx src/auth/cli.ts",
    "providers": "tsx src/gateway/language/local/cli.ts",
    "export": "tsx src/conversations/export-cli.ts",
    "sandbox:prepare": "tsx src/sandbox/cli.ts prepare",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@flue/opentelemetry": "2.0.3",
    "@flue/runtime": "2.0.3",
    "@flue/sdk": "2.0.3",
    "@flue/vite": "2.0.3",
    "@hono/node-server": "^2.0.3",
    "@napi-rs/keyring": "^1.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "hono": "^4.12.31",
    "playwright-core": "^1.63.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.1.2",
    "vitest": "^4.0.8"
  },
  "packageManager": "pnpm@11.22.0"
}
