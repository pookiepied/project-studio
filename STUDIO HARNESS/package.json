{
  "name": "project-studio-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Project Studio agent harness",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "auth": "tsx src/auth/cli.ts",
    "providers": "tsx src/models/local/cli.ts",
    "sandbox:prepare": "tsx src/sandbox/cli.ts prepare",
    "sandbox:list": "tsx src/sandbox/cli.ts list",
    "sandbox:release": "tsx src/sandbox/cli.ts",
    "build": "flue build --target node",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@flue/opentelemetry": "1.0.0-beta.3",
    "@flue/runtime": "1.0.0-beta.9",
    "@flue/sdk": "1.0.0-beta.9",
    "@napi-rs/keyring": "^1.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "hono": "^4.12.31",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@flue/cli": "1.0.0-beta.9",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.8"
  },
  "packageManager": "pnpm@10.23.0"
}
