{
  "name": "studio-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Studio Data - user-owned content: conversations, uploads, generated artifacts",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "verify": "npm run build && npm run verify:transcripts && npm run verify:integration",
    "verify:transcripts": "node scripts/verify-transcript-contract.mjs",
    "verify:integration": "node scripts/verify-local-integration.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@types/node": "^25.9.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.71.0"
  }
}
